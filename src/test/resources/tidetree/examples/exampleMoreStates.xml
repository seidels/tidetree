<?xml version='1.0' encoding='UTF-8'?>
<beast version="2.8"
       namespace="beast.core:beast.core.util:beast.evolution.alignment:beast.evolution.nuc:beast.evolution.operators:beast.evolution.sitemodel:beast.evolution.substitutionmodel:beast.evolution.tree.coalescent:beast.base.core:beast.base.evolution.alignment:beast.base.evolution.likelihood:beast.base.evolution.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.tree:beast.base.evolution.tree.coalescent:beast.base.inference:beast.base.inference.operator:beast.base.inference.util:beast.pkgmgmt"
       beautitemplate="MultiTypeBirthDeath"
       beautistatus=""
       required="">

<!--
This is an example xml that can be adapted to use TiDeTree on your data.
In this example, a population of cells was grown for 54h. Editing was induced from
time point 0 for 36h and 10 cells were sampled.

Running the analysis infers the tree linking the 10 cells and the cells' division rate.

Note that some words in this xml refer to time flowing either forward or backward.
Forward time is used to count the hours from the start of the experiment (so some time in the past)
toward the time when the cells were sampled. (e.g. in dateTrait, date-forward).
Backward time or height counts the hours the other way around, i.e. the duration between when the cells where sampled
and some time in the past. (e.g. the scarring height is the duration between sampling the cells and the time when
scarring started.
-->

<!-- syntactic sugar -->

<!-- input data -->
<data id="s1_c1_data.txt" spec="Alignment" name="alignment">
    <userDataType spec="tidetree.evolution.datatype.EditData" nrOfStates="4"/>
<sequence id="cell_1" spec="Sequence" taxon="1" value="1,2,0,1,1,0,1,2,1,3,"/>
<sequence id="cell_2" spec="Sequence" taxon="2" value="1,0,0,1,1,0,1,2,1,3,"/>
<sequence id="cell_3" spec="Sequence" taxon="3" value="1,0,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_4" spec="Sequence" taxon="4" value="1,0,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_5" spec="Sequence" taxon="5" value="2,2,0,1,1,0,1,1,1,0,"/>
<sequence id="cell_6" spec="Sequence" taxon="6" value="2,2,0,1,2,3,1,1,1,0,"/>
<sequence id="cell_8" spec="Sequence" taxon="7" value="1,0,1,2,2,0,2,2,1,0,"/>
<sequence id="cell_9" spec="Sequence" taxon="8" value="1,0,1,2,2,0,2,2,1,0,"/>
<sequence id="cell_10" spec="Sequence" taxon="9" value="2,0,0,1,1,0,1,1,1,0,"/>
</data>

<!-- define set of taxa based on alignment - cells in this context -->
<taxa id="TaxonSet" spec="TaxonSet">
    <alignment idref="s1_c1_data.txt"/>
</taxa>

<!-- specify tip dates, here 54h after the start of the experiment -->
<traitSet id="dateTrait" spec="beast.base.evolution.tree.TraitSet" taxa="@TaxonSet" traitname="date-forward" value="1=54,2=54,3=54,4=54,5=54,6=54,7=54,8=54,9=54"/>

  <substModel id="substModel" spec="tidetree.substitutionmodel.EditAndSilencingModel" editRates="@editRate" silencingRate="@silencingRate" editHeight="54" editDuration="36">
    <frequencies id="freqs" spec="beast.base.spec.evolution.substitutionmodel.Frequencies">
        <frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="1 0 0 0" estimate="false"/>
    </frequencies>
  </substModel>

  <siteModel spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel" mutationRate="@mutationRate" proportionInvariant="@proportionInvariant" gammaCategoryCount="0" substModel="@substModel">
  </siteModel>

<run id="mcmc" spec="MCMC" chainLength="1000000000">

    <!-- here the parameter of the model are defined that will be operated on (i.e. estimated) during the MCMC -->
    <state id="state" spec="State" storeEvery="5000">
            <stateNode id="tree" spec="tidetree.tree.StartingTree" rootHeight="54" taxa="@s1_c1_data.txt" editHeight="54" editDuration="36" sequencesAreClustered="false">
                <trait idref="dateTrait"/>
                <taxonset idref="TaxonSet"/>
            </stateNode>

        <!-- find the definition of the scarring, loss rate and clock rate in the TiDeTree manuscript -->
          <parameter id="editRate" dimension="1" name="stateNode" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal"> 0.8 0.1 0.1
          </parameter>
        <parameter id="silencingRate" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="NonNegativeReal"> 0.0</parameter>

        <!-- the clock rate is the rate of acquiring edited state 2  -->
        <parameter id="clockRate.c" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">1.0</parameter>
        <!-- the mutation rate could be another rate multiplier, but we leave it fixed to 1 -->
        <parameter estimate="false" id="mutationRate" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</parameter>

        <parameter estimate="false" id="proportionInvariant" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval">0.0</parameter>

        <!-- the following parameters belong to the Yule (pure-birth) tree prior -->
        <!-- birth rate corresponds to cell division rate -->
        <parameter id="birthRate" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">0.6</parameter>

        <!-- The origin is the start of the population process (see Stadler2013), i.e. in most applications the time that passed
         from the start of the experiment until the cells are sequenced. Here this is 54h. -->
        <parameter id="origin" name="stateNode" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">54.001</parameter>

    </state>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">

        <!-- Prior distributions -->
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">

            <!-- The tree prior (or population dynamic model): the Yule (pure-birth) model -->
                <distribution id="yuleModel" spec="beast.base.spec.evolution.speciation.YuleModel" conditionalOnRoot="False" tree="@tree" originHeight="@origin" birthDiffRate="@birthRate">
                </distribution>

            <!-- prior distributions on the substitution model parameters -->
            <distribution id="editRatePrior" spec="beast.base.spec.inference.distribution.IID" param="@editRate">
                <distr spec="beast.base.spec.inference.distribution.LogNormal">
                  <parameter estimate="false" name="M" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real">-4.0</parameter>
                  <parameter estimate="false" name="S" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal">1.0</parameter>
                </distr>
            </distribution>

            <distribution id="Uniform.0" spec="beast.base.spec.inference.distribution.Uniform" param="@clockRate.c" upper="1.0E6"/>

            <!-- prior distributions on phylodynamic parameters -->
            <!-- [0.4, 2.7] -->
            <distribution id="birthRatePrior" spec="beast.base.spec.inference.distribution.LogNormal" param="@birthRate" M="0" S="0.6"/>
        </distribution>

        <!-- Tree likelihood -->
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">

                <distribution id="treeLikelihood" spec="tidetree.distributions.TreeLikelihoodWithEditWindow" data="@s1_c1_data.txt" origin="@origin" tree="@tree" siteModel="@siteModel">
                    <branchRateModel spec="beast.base.spec.evolution.branchratemodel.StrictClockModel" clock.rate="@clockRate.c"/>
                </distribution>

        </distribution>
    </distribution>

   <!-- tree operators -->
           <!-- operator  spec="tidetree.operators.WilsonBaldingSubTrees"
                      tree="@tree" weight="30.0" scarringStopHeight="18"/ -->

            <operator tree="@tree" weight="30.0" spec="beast.base.evolution.operator.Uniform"/>

            <operator spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@tree" weight="3.0"/>
            <operator spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@tree" weight="3.0" size="30"/>
            <operator spec="Exchange" isNarrow="false" tree="@tree" weight="30.0"/>

	<!-- Operators on phylogenetic parameters-->
	<!-- operator on edit probabilities while keeping their sum fixed to 1 -->
	  <operator id="editRateScaler" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" parameter="@editRate" weight="3.0"/>
    <operator id="clockRateScaler" parameter="@clockRate.c" scaleFactor="0.8" weight="3.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

   <!-- Operators on phylodynamic parameters -->
    <operator id="birthRateScaler" parameter="@birthRate" scaleFactor="0.8" weight="3.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <!-- Log parameters -->
    <logger id="tracelog" spec="Logger" fileName="$(filebase).$(seed).log" logEvery="10000">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood"/>
        <log id="treeHeight" spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
        <log idref="editRate"/>
        <log idref="silencingRate"/>
        <log idref="clockRate.c"/>
        <log idref="birthRate"/>
    </logger>

    <logger id="screenlog" spec="Logger" logEvery="1000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="beast.base.spec.inference.util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <!-- log tree -->
    <logger id="treelog.t:cluster" spec="Logger" fileName="$(filebase).$(tree).$(seed).trees" logEvery="10000" mode="tree">
                <log idref="tree" printMetaData="true"/>
    </logger>

</run>

</beast>
