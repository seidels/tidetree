<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<beast beautitemplate='MultiTypeBirthDeath' beautistatus=''
       namespace="beast.pkgmgmt
       :beast.base.core
       :beast.base.inference
       :beast.base.evolution.alignment
       :beast.base.evolution.tree
       :beast.base.evolution.tree.coalescent
       :beast.base.inference.util
       :beast.evolution.nuc
       :beast.base.evolution.operator
       :beast.base.inference.operator
       :beast.base.evolution.sitemodel
       :beast.base.evolution.substitutionmodel
       :beast.base.spec.inference.parameter
       :beast.base.spec.inference.distribution
       :beast.base.spec.inference.operator
       :beast.base.spec.evolution.substitutionmodel
       :beast.base.spec.evolution.sitemodel
       :beast.base.spec.evolution.branchratemodel
       :beast.base.spec.evolution.speciation
       :beast.base.spec.evolution.operator
       :tidetree
       :beast.base.evolution.likelihood" required="" version="2.8">

<!--
This is an example xml that can be adapted to use TiDeTree on your data.
In this example, a population of cells was grown for 54h. Editing was induced from
time point 0 for 36h and 10 cells were sampled.

Running the analysis infers the tree linking the 10 cells and the cells' division and death rate.

Note that some words in this xml refer to time flowing either forward or backward.
Forward time is used to count the hours from the start of the experiment (so some time in the past)
toward the time when the cells were sampled. (e.g. in dateTrait, date-forward).
Backward time or height counts the hours the other way around, i.e. the duration between when the cells where sampled
and some time in the past. (e.g. the scarring height is the duration between sampling the cells and the time when
scarring started.
-->

<!-- syntactic sugar -->
<map name="Uniform" >beast.base.spec.inference.distribution.Uniform</map>
<map name="Exponential" >beast.base.spec.inference.distribution.Exponential</map>
<map name="LogNormal" >beast.base.spec.inference.distribution.LogNormal</map>
<map name="Normal" >beast.base.spec.inference.distribution.Normal</map>
<map name="Beta" >beast.base.spec.inference.distribution.Beta</map>
<map name="Gamma" >beast.base.spec.inference.distribution.Gamma</map>
<map name="LaplaceDistribution" >beast.base.spec.inference.distribution.Laplace</map>
<map name="InverseGamma" >beast.base.spec.inference.distribution.InverseGamma</map>
<map name="OneOnX" >beast.base.inference.distribution.OneOnX</map>

<!-- input data -->
<data  id="s1_c1_data.txt" spec="Alignment" name="alignment">
    <userDataType spec="tidetree.evolution.datatype.EditData"
                     nrOfStates="3" />
<sequence id="cell_1" spec="Sequence" taxon="1" value="1,2,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_2" spec="Sequence" taxon="2" value="1,0,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_3" spec="Sequence" taxon="3" value="1,0,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_4" spec="Sequence" taxon="4" value="1,0,0,1,1,0,1,2,1,0,"/>
<sequence id="cell_5" spec="Sequence" taxon="5" value="2,2,0,1,1,0,1,1,1,0,"/>
<sequence id="cell_6" spec="Sequence" taxon="6" value="2,2,0,1,2,0,1,1,1,0,"/>
<sequence id="cell_8" spec="Sequence" taxon="7" value="1,0,1,2,2,0,2,2,1,0,"/>
<sequence id="cell_9" spec="Sequence" taxon="8" value="1,0,1,2,2,0,2,2,1,0,"/>
<sequence id="cell_10" spec="Sequence" taxon="9" value="2,0,0,1,1,0,1,1,1,0,"/>
</data>

<!-- define set of taxa based on alignment - cells in this context -->
<taxa id="TaxonSet" spec="TaxonSet">
    <alignment idref="s1_c1_data.txt"/>
</taxa>

<!-- specify tip dates, here 54h after the start of the experiment -->
<traitSet id="dateTrait" spec="beast.base.evolution.tree.TraitSet" taxa="@TaxonSet" traitname="date-forward"
	  value="1=54,2=54,3=54,4=54,5=54,6=54,7=54,8=54,9=54"/>

<!-- fixed (non-estimated) timing parameters, shared between the substitution model and the starting tree -->
<parameter id="rootHeight" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="54"/>
<parameter id="editHeight" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="54"/>
<parameter id="editDuration" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="NonNegativeReal" estimate="false" value="36"/>

  <substModel id="substModel"
               spec="tidetree.substitutionmodel.EditAndSilencingModel"
               editRates="@editRate" silencingRate="@silencingRate"
               editHeight="@editHeight" editDuration="@editDuration">
    <frequencies id="freqs" spec="beast.base.spec.evolution.substitutionmodel.Frequencies">
        <frequencies spec="beast.base.spec.inference.parameter.SimplexParam" value="1 0 0" estimate="false"/>
    </frequencies>
  </substModel>

  <siteModel spec="beast.base.spec.evolution.sitemodel.SiteModel" id="siteModel" substModel="@substModel"
              gammaCategoryCount="0">
    <parameter id="mutationRate" name="mutationRate" spec="beast.base.spec.inference.parameter.RealScalarParam"
               domain="PositiveReal" estimate="false" value="1.0"/>
    <parameter id="proportionInvariant" name="proportionInvariant" spec="beast.base.spec.inference.parameter.RealScalarParam"
               domain="UnitInterval" estimate="false" value="0.0"/>
  </siteModel>


<run id="mcmc" spec="MCMC" chainLength="1000000000">

    <!-- here the parameter of the model are defined that will be operated on (i.e. estimated) during the MCMC -->
    <state id="state" spec="State" storeEvery="5000">
            <stateNode id="tree" spec="tidetree.tree.StartingTree" rootHeight="@rootHeight"
                       taxa="@s1_c1_data.txt" editHeight="@editHeight"
                       editDuration="@editDuration" sequencesAreClustered="false">
                <trait idref="dateTrait"/>
                <taxonset idref="TaxonSet"/>
            </stateNode>

        <!-- find the definition of the scarring, loss rate and clock rate in the TiDeTree manuscript -->
          <parameter id="editRate" spec="beast.base.spec.inference.parameter.RealVectorParam"
		     domain="NonNegativeReal" dimension="2" name="stateNode"> 0.9 0.1
          </parameter>
        <parameter id="silencingRate" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="NonNegativeReal" name="stateNode" value="0.0"/>

        <!-- the clock rate is the rate of acquiring edited state 2  -->
        <parameter id="clockRate.c" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="Real" name="stateNode" value="1.0"/>

        <!-- the following parameters belong to the extended birth-death sampling model by Stadler2013 -->
        <!-- birth rate corresponds to cell division rate -->
        <parameter id="birthRate" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="PositiveReal" name="stateNode" value="0.6"/>
        <!-- death rate corresponds to apoptosis rate -->
        <parameter id="deathRate" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="PositiveReal" name="stateNode" value="0.01"/>
        <!-- sampling rate is a rate of sampling through time; since cells are only collected at single time point we set
        this to 0 and specify the sampling proportion at present: rho -->
        <parameter id="samplingRate" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="NonNegativeReal" name="stateNode" value="0.0"/>
        <parameter id="rho" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="UnitInterval" name="stateNode" value="1.0"/>

        <!-- The origin is the start of the population process (see Stadler2013), i.e. in most applications the time that passed
         from the start of the experiment until the cells are sequenced. Here this is 54h. -->
        <parameter id="origin" spec="beast.base.spec.inference.parameter.RealScalarParam"
                   domain="PositiveReal" name="stateNode" value="54.001"/>

    </state>



    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">

        <!-- Prior distributions -->
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">

            <!-- The tree prior (or population dynamic model): the birth death sampling model -->
                <distribution id="birthDeathSamplingModel" spec="beast.base.spec.evolution.speciation.YuleModel"
                          conditionalOnRoot="False" tree="@tree" originHeight="@origin"
                              birthDiffRate="@birthRate" >
                </distribution>

            <!-- prior distributions on the substitution model parameters -->
            <distribution id="editRatePrior" spec="beast.base.spec.inference.distribution.LogNormal" param="@editRate">
                <parameter name="M" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="-4.0"/>
                <parameter name="S" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
            </distribution>

            <distribution id="ClockPrior.c:LTv2_EBd32_cluster_1" spec="beast.base.spec.inference.distribution.Uniform" param="@clockRate.c" upper="1.0E6"/>


            <!-- prior distributions on phylodynamic parameters -->
            <!-- [0.4, 2.7] -->
            <distribution id="birthRatePrior" spec="beast.base.spec.inference.distribution.LogNormal" param="@birthRate">
                <parameter name="M" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="0"/>
                <parameter name="S" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="0.6"/>
            </distribution>
            <!-- [0.01, 1.4] -->
            <distribution id="deathRatePrior" spec="beast.base.spec.inference.distribution.LogNormal" param="@deathRate">
                <parameter name="M" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="-2"/>
                <parameter name="S" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.4"/>
            </distribution>
        </distribution>

        <!-- Tree likelihood -->
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">

                <distribution id="treeLikelihood"
                              spec="tidetree.distributions.TreeLikelihoodWithEditWindow"
                              data="@s1_c1_data.txt" origin="@origin"
			      tree="@tree"
			      siteModel="@siteModel">
                    <branchRateModel id="clockModel" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <parameter idref="clockRate.c" name="clock.rate"/>
                    </branchRateModel>
                </distribution>

        </distribution>
    </distribution>

   <!-- tree operators -->
           <!-- operator  spec="tidetree.operators.WilsonBaldingSubTrees"
                      tree="@tree" weight="30.0" scarringStopHeight="18"/ -->

            <operator  spec="Uniform" tree="@tree" weight="30.0"/>

            <operator  spec="SubtreeSlide" tree="@tree" weight="3.0"/>
            <operator spec="SubtreeSlide" tree="@tree" weight="3.0" size="30"/>
            <operator  spec="Exchange" isNarrow="false" tree="@tree" weight="30.0"/>


	<!-- Operators on phylogenetic parameters-->
	<!-- operator on edit probabilities while keeping their sum fixed to 1 -->
	  <operator id="editRateScaler" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" rvparameter="@editRate"
                 weight="3.0"/>
    <operator id="clockRateScaler" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@clockRate.c"
              scaleFactor="0.8" weight="3.0"/>


   <!-- Operators on phylodynamic parameters -->
    <operator id="birthRateScaler" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@birthRate" scaleFactor="0.8" weight="3.0"/>
    <operator id="deathRateScaler" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@deathRate" scaleFactor="0.8" weight="3.0"/>

    <operator id="updownBD.t:LTv2_EBd32_cluster_1" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.8" weight="30.0">
         <up idref="birthRate"/>
         <down idref="deathRate"/>
    </operator>


    <!-- Log parameters -->
    <logger id="tracelog" spec="Logger" fileName="$(filebase).$(seed).log" logEvery="10000">
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood"/>
        <log id="treeHeight"
                 spec="beast.base.evolution.tree.TreeStatLogger"
                 tree="@tree"/>
        <log idref="editRate"/>
        <log idref="silencingRate" />
        <log idref="clockRate.c"/>
        <log idref="birthRate"/>
        <log idref="rho"/>
        <log idref="deathRate"/>
    </logger>

    <logger id="screenlog" spec="Logger" logEvery="1000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>


    <!-- log tree -->
    <logger id="treelog.t:cluster" spec="Logger" fileName="$(filebase).$(tree).$(seed).trees" logEvery="10000" mode="tree">
                <log idref="tree" printMetaData="true"/>
    </logger>


</run>

</beast>
